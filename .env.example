# Environment Configuration Template for Taqs App
# Copy this file to .env for local development with sensitive values.
# NEVER commit .env to version control!

# Phase 2 API Configurations (e.g., Open-Meteo or custom proxy endpoints)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
GEOCODING_API_BASE_URL=https://geocoding-api.open-meteo.com/v1

# Optional Analytics or Monitoring Keys (Phase 2+)
APP_ENV=development
API_TIMEOUT_SECONDS=15
